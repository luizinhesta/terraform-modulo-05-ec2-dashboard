[Unit]
Description=EC2 Server Dashboard (backend Python)
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
ExecStart=/usr/bin/python3 /opt/dashboard/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
