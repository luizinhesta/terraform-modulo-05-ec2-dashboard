# Copie para terraform.tfvars (não versionado) e ajuste.

aws_region   = "us-east-1"
project_name = "tfpratica"
environment  = "lab"

# --- Rede ---
# Opção 1 (padrão): usar a VPC padrão da região. Deixe vpc_id e subnet_id nulos.
# Opção 2: usar uma VPC/subnet específicas.
# vpc_id    = "vpc-0123456789abcdef0"
# subnet_id = "subnet-0123456789abcdef0"
# Opção 3: criar VPC, subnet, IGW e route table do laboratório.
# create_lab_network = true

# Restrinja ao seu IP quando possível (ex.: "203.0.113.10/32").
allowed_http_cidr = "0.0.0.0/0"

instance_type = "t3.micro"
architecture  = "x86_64" # use "arm64" com tipos como t4g.micro
